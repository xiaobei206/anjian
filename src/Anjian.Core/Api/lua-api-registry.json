    {
      "id": "anjian.mouse.move-to",
      "name": "MoveTo",
      "category": "mouse",
      "title": "移动鼠标",
      "description": "移动到虚拟桌面绝对物理像素坐标；副屏可使用负坐标。",
      "signature": "MoveTo(x, y)",
      "parameters": [
        {
          "name": "x",
          "type": "integer",
          "required": true,
          "description": "虚拟桌面物理像素 X 坐标；允许负值。",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "unit": "物理像素"
        },
        {
          "name": "y",
          "type": "integer",
          "required": true,
          "description": "虚拟桌面物理像素 Y 坐标；允许负值。",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "unit": "物理像素"
        }
      ],
      "returns": {
        "type": "nil",
        "description": "无显式返回值；成功后继续执行后续 Lua 语句。"
      },
      "errors": [
        "参数类型、整数性或范围不合法时产生 Lua 错误。",
        "输入调用失败、权限不足或目标程序拒绝输入时会报告执行错误。"
      ],
      "behavior": {
        "pauseBehavior": "在执行器命令检查点遵循暂停状态。",
        "cancellationBehavior": "停止会终止 worker；主进程清理本程序持有的键鼠状态。",
        "sideEffects": [
          "改变系统鼠标指针位置。"
        ],
        "coordinateSpace": "screen（虚拟桌面绝对物理像素）",
        "permissionNotes": "使用 SetCursorPos；坐标为物理像素，允许负值。权限和桌面会话受 Windows 约束。"
      },
      "example": "MoveTo(-120, 450)",
      "implementationStatus": "implemented",
      "verificationStatus": "automated-contract-test;desktop-unverified",
      "introducedIn": "0.1.0-preview.1",
      "runtime": {
        "definition": "function(x, y) __AnjianBridge_MoveTo(x, y) end",
        "bindings": [
          {
            "name": "__MoveTo",
            "method": "MoveTo",
            "localName": "__AnjianBridge_MoveTo"
          }
        ]
      }
    },
    {
      "id": "anjian.mouse.left-click",
      "name": "LeftClick",
      "category": "mouse",
      "title": "左键单击",
      "description": "左键单击并在指定时间后释放；省略时长默认 50 毫秒。",
      "signature": "LeftClick(holdMs?)",
      "parameters": [
        {
          "name": "holdMs",
          "type": "integer",
          "required": false,
          "description": "按钮按下持续时间；0 表示不增加人为等待。",
          "defaultValue": 50,
          "minimum": 0,
          "maximum": 600000,
          "unit": "毫秒"
        }
      ],
      "returns": {
        "type": "nil",
        "description": "无显式返回值；成功后继续执行后续 Lua 语句。"
      },
      "errors": [
        "参数类型、整数性或范围不合法时产生 Lua 错误。",
        "输入调用失败、权限不足或目标程序拒绝输入时会报告执行错误。"
      ],
      "behavior": {
        "pauseBehavior": "在执行器命令检查点遵循暂停状态。",
        "cancellationBehavior": "点击等待可被停止取消；正常结束、错误或取消时尝试释放，worker 退出时主进程再清理。",
        "sideEffects": [
          "按下并释放鼠标左键。"
        ],
        "coordinateSpace": "none",
        "permissionNotes": "使用 Windows SendInput；目标程序可能因权限、桌面或自身输入处理而拒绝。"
      },
      "example": "LeftClick()",
      "implementationStatus": "implemented",
      "verificationStatus": "automated-contract-test;desktop-unverified",
      "introducedIn": "0.1.0-preview.1",
      "runtime": {
        "definition": "function(ms) __AnjianBridge_LeftClick(ms == nil and 50 or ms) end",
        "bindings": [
          {
            "name": "__LeftClick",
            "method": "LeftClick",
            "localName": "__AnjianBridge_LeftClick"
          }
        ]
      }
    },
