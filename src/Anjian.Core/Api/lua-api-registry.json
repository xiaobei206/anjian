          "minimum": 0,
          "maximum": 600000,
          "unit": "毫秒"
        },
        {
          "name": "gapMs",
          "type": "integer",
          "required": false,
          "description": "两次单击之间的延时。",
          "defaultValue": 100,
          "minimum": 0,
          "maximum": 600000,
          "unit": "毫秒"
